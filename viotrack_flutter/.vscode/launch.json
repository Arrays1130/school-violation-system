{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VioTrack · Android Emulator · Production",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}",
      "program": "lib/main.dart",
      "deviceId": "emulator-5554",
      "flutterMode": "debug",
      "vmServiceTimeout": 180,
      "deviceTimeout": 120,
      "preLaunchTask": "flutter: stop app",
      "toolArgs": [
        "--dart-define=API_BASE_URL=https://school-violation-system.onrender.com/api",
